FLASK_ENV=development
SECRET_KEY=troque-esta-chave-em-producao

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=painel_senha

# Alternativa: defina a URI completa e ela tem prioridade sobre as variáveis DB_*
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/painel_senha

# Encerramento automático das sessões de atendimento (seção 10.18 do BLUEPRINT) -
# a clínica fecha antes desse horário, então nunca há atendimento genuíno em
# curso nesse ponto. Formato HH:MM (24h), interpretado no FUSO_HORARIO abaixo.
HORARIO_ENCERRAMENTO_SESSOES=23:00
AVISO_ENCERRAMENTO_MINUTOS=5

# Fuso horário da clínica (IANA), usado nas decisões de relógio de parede
# (encerramento automático e horário de funcionamento das filas). Resolvido no
# código, NÃO no fuso do SO - um servidor em UTC continua correto. Só mude se a
# clínica não estiver no horário de Brasília.
FUSO_HORARIO=America/Sao_Paulo
